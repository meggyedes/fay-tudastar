    <g fill="#6EE0FF"><circle cx="102" cy="154" r="5"></circle><circle cx="538" cy="118" r="5"></circle><circle cx="578" cy="199" r="5"></circle></g>
    <path d="M102 154h82l38 34M538 118h-55l-21 45M578 199h-41l-30 27" stroke="#4CD1FF" stroke-dasharray="5 7" stroke-width="2"></path>
  </svg>
{% endmacro %}
