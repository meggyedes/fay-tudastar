<!doctype html>
<html lang="{{ site.language }}" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111920" media="(prefers-color-scheme: dark)">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="hu_HU">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.name }}">
    <meta property="og:description" content="{{ description or site.description }}">
    {% if site.url %}
      <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
      <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
    {% endif %}
    <link rel="stylesheet" href="{{ '/assets/vendor/bootstrap/bootstrap.min.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
    <script>
      (function () {
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem('theme');
        } catch (_) {
          // A rendszerbeállítás marad az alapértelmezett, ha a tárhely nem elérhető.
        }
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.bsTheme = storedTheme || systemTheme;
      }());
    </script>
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [['\\(', '\\)'], ['$', '$']],
          displayMath: [['\\[', '\\]'], ['$$', '$$']]
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
        }
      };
    </script>
    <script defer src="{{ '/assets/vendor/mathjax/tex-mml-chtml.js' | url }}"></script>
  </head>
  <body class="site-shell">
    <a class="visually-hidden-focusable skip-link" href="#main-content">Ugrás a tartalomhoz</a>
    {% set isHome = page.url == '/' %}
    {% set isSubjects = page.url | startsWith('/subjects/') %}
    {% set isLessons = page.url | startsWith('/lessons/') %}
    {% set isTopics = page.url | startsWith('/topics/') %}
    {% set isSearch = page.url == '/search/' %}
    <header class="site-header border-bottom">
      <nav class="navbar navbar-expand-lg py-2" aria-label="Fő navigáció">
        <div class="container">
          <a class="navbar-brand" href="{{ '/' | url }}">{{ site.name }}</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Navigáció megnyitása">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div id="main-navigation" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
              <li class="nav-item"><a class="nav-link{% if isHome %} active{% endif %}" href="{{ '/' | url }}"{% if isHome %} aria-current="page"{% endif %}>Főoldal</a></li>
              <li class="nav-item"><a class="nav-link{% if isSubjects %} active{% endif %}" href="{{ '/subjects/' | url }}"{% if isSubjects %} aria-current="page"{% endif %}>Tantárgyak</a></li>
              <li class="nav-item"><a class="nav-link{% if isLessons %} active{% endif %}" href="{{ '/lessons/' | url }}"{% if isLessons %} aria-current="page"{% endif %}>Leckék</a></li>
              <li class="nav-item"><a class="nav-link{% if isTopics %} active{% endif %}" href="{{ '/topics/' | url }}"{% if isTopics %} aria-current="page"{% endif %}>Témák</a></li>
              <li class="nav-item"><a class="nav-link{% if isSearch %} active{% endif %}" href="{{ '/search/' | url }}"{% if isSearch %} aria-current="page"{% endif %}>Keresés</a></li>
            </ul>
            <button class="btn theme-toggle ms-lg-3" type="button" data-theme-toggle aria-label="Sötét mód bekapcsolása" aria-pressed="false">Téma</button>
          </div>
        </div>
      </nav>
    </header>
    <main id="main-content" class="site-main">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <div class="container py-4 d-flex flex-column flex-sm-row gap-1 justify-content-between">
        <span>Iskolai Tudástár</span>
        <span>Személyes digitális jegyzetgyűjtemény</span>
      </div>
    </footer>
    <script src="{{ '/assets/vendor/bootstrap/bootstrap.bundle.min.js' | url }}"></script>
    <script src="{{ '/assets/js/theme.js' | url }}"></script>
  </body>
</html>
