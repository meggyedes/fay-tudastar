---
layout: layouts/base.njk
title: Kezdőlap
description: Gépjármű-mechatronikai tananyagok és rendezett műszaki jegyzetek egy helyen.
---
{% from "components/home-icons.njk" import homeIcon as icon %}
<section class="hp-hero" aria-labelledby="home-title">
  <div class="hp-hero__art" aria-hidden="true"><img src="{{ '/assets/images/Kocsi.png' | url }}" alt="" width="1536" height="1024"></div>
  <div class="container hp-shell hp-hero__inner">
    <div class="hp-hero__copy">
      <p class="hp-eyebrow">Tudás. Gyakorlat. Jövő.</p>
      <h1 id="home-title">Gépjármű<br>mechatronikai<br><span>tananyagok, egy helyen.</span></h1>
      <p class="hp-hero__lead">Rendszerezett, kereshető jegyzetek, ábrák és gyakorlati példák a modern gépjármű mechatronika világából.</p>
      <div class="hp-actions">
        <a class="btn hp-button" href="{{ '/subjects/' | url }}">Tantárgyak megnyitása {{ icon('arrow') }}</a>
        <a class="btn hp-button hp-button--outline" href="{{ '/search/' | url }}">{{ icon('search') }} Keresés a tudástárban</a>
      </div>
    </div>
    <p class="hp-handwriting hp-hero__note" aria-hidden="true">A jármű<br>rendszerben él.</p>
    <div class="hp-hero__systems" role="group" aria-label="Műszaki területek">
      <span>{{ icon('chip') }} <small>Elektronika</small></span><span>{{ icon('pulse') }} <small>Diagnosztika</small></span><span>{{ icon('cog') }} <small>Mechanika</small></span><span>{{ icon('bolt') }} <small>Villamosság</small></span>
    </div>
    <div class="hp-benefits">
      <span>{{ icon('book') }} <span><strong>Tanulj</strong> saját tempódban</span></span><span>{{ icon('cog') }} <span><strong>Értsd meg</strong> a rendszereket</span></span><span>{{ icon('chart') }} <span><strong>Alkalmazd</strong> a gyakorlatban</span></span><span>{{ icon('bulb') }} <span><strong>Építsd a jövőd</strong></span></span>
    </div>
    <p class="hp-handwriting hp-hero__signature" aria-hidden="true">Több, mint elmélet.<br>Valódi tudás.</p>
  </div>
</section>
<div class="container hp-shell hp-content">
  <section class="hp-overview" aria-labelledby="statistics-heading">
    <h2 id="statistics-heading" class="visually-hidden">A tudástár számai</h2>
    <div class="hp-stats">
      <div class="hp-stat hp-tone-blue"><span class="hp-stat__icon">{{ icon('book') }}</span><div><strong>{{ subjects.length }}</strong><span>Tantárgy</span><small>Átfogó tananyagok</small></div></div>
      <div class="hp-stat hp-tone-green"><span class="hp-stat__icon">{{ icon('file') }}</span><div><strong>{{ lessons.length }}</strong><span>Lecke</span><small>Részletes jegyzetek</small></div></div>
      <div class="hp-stat hp-tone-orange"><span class="hp-stat__icon">{{ icon('tag') }}</span><div><strong>{{ topics.length }}</strong><span>Téma</span><small>Kereshető tartalom</small></div></div>
      <div class="hp-stat hp-tone-blue"><span class="hp-stat__icon">{{ icon('chart') }}</span><div><strong>{{ searchIndexWords }}</strong><span>Szó a keresőindexben</span><small>Pagefind keresés</small></div></div>
    </div>
    <blockquote class="hp-quote"><p>„A jó szakember<br>nem csak javít, hanem<br>meg is érti, miért működik.”</p></blockquote>
  </section>
  <section class="hp-areas" aria-labelledby="subjects-heading">
    <div class="hp-section-heading">
      <div class="hp-heading-copy">{{ icon('circuit') }}<div><h2 id="subjects-heading">Szakmai területek</h2><p>Fedezd fel a gépjármű mechatronika főbb területeit, és merülj el a részletes tananyagokban!</p></div></div>
      <a class="hp-section-link" href="{{ '/subjects/' | url }}">Összes tantárgy megtekintése {{ icon('arrow') }}</a>
    </div>
    <div class="hp-area-grid">
      {% for area in areas %}
        <article class="hp-area hp-tone-{{ area.tone }}">
          <img class="hp-area__art" src="{{ ('/assets/images/' + area.image) | url }}" alt="{{ area.title }} illusztráció" width="1536" height="1024" loading="lazy">
          <div class="hp-area__copy"><span class="hp-area__icon">{{ icon(area.icon) }}</span><h3><a class="stretched-link" href="{{ area.href | url }}">{{ area.title }}</a></h3><p>{{ area.description }}</p><span class="hp-round-arrow" aria-hidden="true">{{ icon('arrow') }}</span></div>
        </article>
      {% endfor %}
    </div>
  </section>
  <section class="hp-recent hp-recent--full" aria-labelledby="recent-heading">
      <div class="hp-section-heading"><div class="hp-heading-copy">{{ icon('clipboard') }}<h2 id="recent-heading">Legutóbbi leckék</h2></div><a class="hp-section-link" href="{{ '/lessons/' | url }}">Összes lecke {{ icon('arrow') }}</a></div>
      <div class="hp-lesson-list">
        {% for lesson in lessons | take(5) %}
          {% set presentation = subjectPresentation[lesson.subjectSlug] %}
          <article class="hp-lesson hp-tone-{{ presentation.tone or 'blue' }}">
            <img class="hp-lesson__thumb" src="{{ ('/assets/images/' + (presentation.image or 'Kocsi.png')) | url }}" alt="" width="96" height="64" loading="lazy">
            <div class="hp-lesson__content"><h3><a class="stretched-link" href="{{ ('/lessons/' + lesson.slug + '/') | url }}">{{ lesson.title }}</a></h3><div class="hp-lesson__meta"><a class="hp-badge hp-badge--subject" href="{{ ('/subjects/' + lesson.subjectSlug + '/') | url }}" aria-label="{{ lesson.subject }}">{{ presentation.label or lesson.subject }}</a>{% for topic in lesson.topics | take(1) %}<a class="hp-badge" href="{{ ('/topics/' + (topic | slugify) + '/') | url }}">{{ topic }}</a>{% endfor %}</div></div>
            <time datetime="{{ lesson.date }}" aria-label="{{ lesson.date | hungarianDate }}">{{ lesson.date | replace('-', '. ') }}.</time><span class="hp-lesson__arrow" aria-hidden="true">{{ icon('arrow') }}</span>
          </article>
        {% endfor %}
      </div>
    </section>
</div>
