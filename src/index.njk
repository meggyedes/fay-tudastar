---
layout: layouts/base.njk
title: Kezdőlap
description: Gépjármű-mechatronikai tananyagok és rendezett műszaki jegyzetek egy helyen.
---

{% from "components/icons.njk" import icon, heroMachine %}

<section class="home-hero" aria-labelledby="home-title">
  <div class="container page-shell home-hero__grid">
    <div class="home-hero__copy">
      <p class="section-kicker home-hero__eyebrow">Fáy Tudástár · gépjármű mechatronika</p>
      <h1 id="home-title" class="home-hero__title">Gépjármű-mechatronikai tananyagok, egy helyen.</h1>
      <p class="home-hero__lead">Rendszerezett, kereshető jegyzetek, képletek és gyakorlati példák a modern járműtechnika világából.</p>
      <div class="home-hero__actions">
        <a class="btn btn-accent btn-lg" href="{{ '/subjects/' | url }}">Tantárgyak megnyitása {{ icon('arrow', 'btn-icon') }}</a>
        <a class="btn btn-tech-outline btn-lg" href="{{ '/search/' | url }}">{{ icon('search', 'btn-icon') }} Keresés a tudástárban</a>
      </div>
      <div class="hero-signal" aria-label="A tudástár technikai területei">
        <span>{{ icon('engine') }} Motor és hajtás</span>
        <span>{{ icon('chip') }} Elektronika</span>
        <span>{{ icon('diagnostic') }} Diagnosztika</span>
      </div>
    </div>
    <div class="home-hero__visual" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="hero-orbit hero-orbit--one"></div>
      <div class="hero-orbit hero-orbit--two"></div>
      {{ heroMachine() }}
      <div class="hero-telemetry hero-telemetry--chip"><span>{{ icon('chip') }}</span><small>ECU / vezérlés</small></div>
      <div class="hero-telemetry hero-telemetry--pulse"><span>{{ icon('diagnostic') }}</span><small>Élő diagnosztika</small></div>
    </div>
  </div>
</section>

<section class="container page-shell home-stats" aria-labelledby="statistics-heading">
  <h2 id="statistics-heading" class="visually-hidden">A tudástár számai</h2>
  <div class="row g-3">
    <div class="col-12 col-sm-4">
      <article class="stat-card stat-card--blue p-3 p-md-4"><span class="stat-card__icon">{{ icon('book') }}</span><div><p class="stat-card__value mb-0">{{ subjects.length }}</p><p class="stat-card__label mb-0">Tantárgy</p></div></article>
    </div>
    <div class="col-12 col-sm-4">
      <article class="stat-card stat-card--green p-3 p-md-4"><span class="stat-card__icon">{{ icon('circuit') }}</span><div><p class="stat-card__value mb-0">{{ lessons.length }}</p><p class="stat-card__label mb-0">Lecke</p></div></article>
    </div>
    <div class="col-12 col-sm-4">
      <article class="stat-card stat-card--orange p-3 p-md-4"><span class="stat-card__icon">{{ icon('tag') }}</span><div><p class="stat-card__value mb-0">{{ topics.length }}</p><p class="stat-card__label mb-0">Téma</p></div></article>
    </div>
  </div>
</section>

<section class="container page-shell home-subjects pb-5" aria-labelledby="subjects-heading">
  <div class="section-heading section-heading--visual d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-2 mb-4">
    <div>
      <p class="section-kicker mb-2">Tanulási területek</p>
      <h2 id="subjects-heading" class="mb-0">Fedezd fel tantárgyanként</h2>
    </div>
    <a class="section-link" href="{{ '/subjects/' | url }}">Minden tantárgy {{ icon('arrow', 'link-icon') }}</a>
  </div>
  <div class="row row-cols-1 row-cols-md-2 g-3 g-lg-4">
    {% for subject in subjects %}
      {% set subjectIcon = 'book' %}
      {% if subject.slug == 'mechanika-gepelemek' %}{% set subjectIcon = 'cog' %}{% endif %}
      {% if subject.slug == 'elektrotan' %}{% set subjectIcon = 'bolt' %}{% endif %}
      {% if subject.slug == 'elektrotechnika-elektronika-villamossagtan' %}{% set subjectIcon = 'chip' %}{% endif %}
      {% if subject.slug == 'gepjarmu-szerkezettan' %}{% set subjectIcon = 'engine' %}{% endif %}
      <div class="col">
        <article class="subject-visual subject-visual--{{ subject.slug }} p-4 p-lg-5">
          <div class="subject-visual__pattern"></div>
          <span class="subject-visual__icon">{{ icon(subjectIcon) }}</span>
          <p class="subject-visual__meta">{{ subject.lessons.length }} lecke · {{ subject.topicCount }} téma</p>
          <h3 class="h3 mb-2"><a class="stretched-link" href="{{ ('/subjects/' + subject.slug + '/') | url }}">{{ subject.name }}</a></h3>
          <p class="mb-4">Rendszerezett tananyag, kapcsolódó témákkal és közvetlen leckeoldalakkal.</p>
          <span class="subject-visual__action">Tantárgy megnyitása {{ icon('arrow', 'link-icon') }}</span>
        </article>
      </div>
    {% endfor %}
  </div>
</section>

<section class="container page-shell pb-5" aria-labelledby="recent-heading">
  <div class="section-heading section-heading--visual d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-2 mb-4">
    <div>
      <p class="section-kicker mb-2">Tanulás folytatása</p>
      <h2 id="recent-heading" class="mb-0">Legutóbbi leckék</h2>
    </div>
    <a class="section-link" href="{{ '/lessons/' | url }}">Összes lecke {{ icon('arrow', 'link-icon') }}</a>
  </div>
  <div class="recent-lessons-list recent-lessons-list--visual">
    {% for lesson in lessons | take(4) %}
      <article class="recent-lesson recent-lesson--visual px-4 py-4">
        <div class="recent-lesson__date"><span>{{ icon('chart') }}</span>{{ lesson.date | hungarianDate }}</div>
        <div>
          <p class="recent-lesson__subject mb-1">{{ lesson.subject }}</p>
          <h3 class="h5 mb-2"><a class="stretched-link text-decoration-none" href="{{ ('/lessons/' + lesson.slug + '/') | url }}">{{ lesson.title }}</a></h3>
          <div class="d-flex flex-wrap gap-1">
            {% for topic in lesson.topics | take(3) %}<a class="topic-badge" href="{{ ('/topics/' + (topic | slugify) + '/') | url }}">{{ topic }}</a>{% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
