{
  "name": "iskolai-tudastar",
  "version": "0.1.0",
  "private": true,
  "description": "Statikus, Markdown-alapú iskolai tudástár.",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "npm run validate && npm run clean && eleventy && pagefind --site _site && npm run validate:site && npm run validate:quality",
