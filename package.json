    "validate:site": "node scripts/validate-site.mjs",
    "validate:quality": "node scripts/validate-quality.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "bootstrap": "^5.3.8",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mathjax-full": "^3.2.1",
    "pagefind": "^1.4.0"
  }
